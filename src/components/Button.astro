---
interface Props {
  href: string;
  variant?: 'solid' | 'ghost';
  class?: string;
  external?: boolean;
  arrow?: boolean;
  ariaLabel?: string;
}
const { href, variant = 'solid', class: className = '', external = false, arrow = true, ariaLabel } = Astro.props;
const label = await Astro.slots.render('default');
---

<a
  href={href}
  class:list={['btn', variant === 'ghost' && 'btn-ghost', className]}
  data-magnetic
  aria-label={ariaLabel}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <span class="roll"><span set:html={label} /><span aria-hidden="true" set:html={label} /></span>
  {
    arrow && (
      <svg class="arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
        <path d="M0 5h12.5M8.5 1l4 4-4 4" stroke="currentColor" stroke-width="1.2" />
      </svg>
    )
  }
</a>

---
import Img from './Img.astro';
import SectionHead from './SectionHead.astro';
import { menu } from '@/data/site';
const fmt = (n: number) => `$${n.toLocaleString('es-MX')}`;
---

<section id="carta" class="relative border-t border-hueso/10 bg-tizne py-[clamp(6rem,12vw,10rem)]" aria-labelledby="carta-title">
  <div class="shell">
    <div class="grid gap-8 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <SectionHead index="02" label="Menú destacado" />
        <h2 id="carta-title" data-split class="h-section mt-8">La carta cambia.<br /><em>El fuego,</em> nunca.</h2>
      </div>
      <p data-fade class="lead md:col-span-5 md:justify-self-end">
        Una selección de lo que sale hoy del fogón. Los platos rotan con la cosecha y con la leña que llega cada
        semana de la Sierra Norte.
      </p>
    </div>

    <div class="mt-[clamp(3.5rem,8vw,7rem)] grid gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Imagen fija que cambia según la categoría visible (escritorio) -->
      <div class="hidden lg:col-span-5 lg:block">
        <div data-menu-stage class="sticky top-28 aspect-[4/5] overflow-hidden bg-carbon">
          {
            menu.map((c, i) => (
              <div data-menu-img={c.id} class="absolute inset-0" style={i === 0 ? '' : 'clip-path: inset(100% 0 0 0)'}>
                <Img name={c.image} alt={c.imageAlt} sizes="40vw" class="h-full w-full object-cover" />
              </div>
            ))
          }
          <div class="pointer-events-none absolute inset-x-0 bottom-0 z-[60] flex items-end justify-between bg-gradient-to-t from-carbon/85 to-transparent p-7">
            <span class="overflow-hidden">
              <span data-menu-counter class="block font-display text-5xl italic [font-variation-settings:'opsz'_96]">I</span>
            </span>
            <span class="eyebrow text-hueso/75">Del fogón a la mesa</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        {
          menu.map((c) => (
            <div data-menu-cat={c.id} data-numeral={c.numeral} class="pb-16 md:pb-24">
              <div data-reveal class="frame mb-8 aspect-[16/10] lg:hidden">
                <Img name={c.image} alt={c.imageAlt} sizes="100vw" />
              </div>
              <div class="flex items-baseline gap-5 border-b border-hueso/15 pb-5">
                <span class="font-display text-2xl italic text-brasa [font-variation-settings:'opsz'_48]">{c.numeral}</span>
                <h3 class="font-display text-[clamp(2rem,3.4vw,3rem)] leading-none [font-variation-settings:'opsz'_72]">{c.label}</h3>
              </div>
              <p class="mt-5 max-w-md text-[0.95rem] italic text-hueso/60">{c.intro}</p>
              <ul class="mt-4">
                {c.dishes.map((d) => (
                  <li data-dish class="group border-b border-hueso/10 py-6">
                    <div class="flex items-baseline gap-4">
                      <h4 class="font-display text-[1.4rem] leading-tight transition-colors duration-500 group-hover:text-brasa [font-variation-settings:'opsz'_36] md:text-[1.6rem]">
                        {d.name}
                      </h4>
                      <span class="mb-[0.35em] h-px min-w-6 flex-1 bg-hueso/15" aria-hidden="true" />
                      <span class="font-sans text-[0.95rem] tabular-nums tracking-wide text-hueso/85">{fmt(d.price)}</span>
                    </div>
                    <p class="mt-2 max-w-[46ch] text-[0.95rem] leading-relaxed text-hueso/60">{d.description}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <div data-fade class="flex flex-col gap-6 border border-hueso/15 p-7 sm:flex-row sm:items-center sm:justify-between md:p-9">
          <div>
            <p class="eyebrow text-brasa">Para toda la mesa</p>
            <p class="mt-3 font-display text-[1.7rem] leading-tight [font-variation-settings:'opsz'_48]">Menú de fogón · siete tiempos</p>
            <p class="mt-2 text-sm text-hueso/60">Maridaje de mezcales y vinos mexicanos · $1,150</p>
          </div>
          <p class="font-display text-[2.4rem] leading-none [font-variation-settings:'opsz'_72]">$2,450</p>
        </div>
        <p class="mt-5 text-xs text-hueso/45">Precios en pesos mexicanos, IVA incluido. Avísenos de cualquier alergia al reservar.</p>
      </div>
    </div>
  </div>
</section>

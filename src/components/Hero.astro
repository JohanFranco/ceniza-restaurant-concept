---
import Img from './Img.astro';
import Button from './Button.astro';
import { brand, contact } from '@/data/site';
---

<section id="top" data-hero class="relative h-[100svh] min-h-[640px] overflow-hidden" aria-labelledby="hero-title">
  <div data-hero-media class="absolute inset-0">
    <div data-hero-img class="absolute inset-0 will-change-transform">
      <Img
        name="hero"
        alt="Carne sobre la parrilla envuelta en humo y llamas de leña"
        sizes="100vw"
        eager
        width={1920}
        height={2891}
        class="h-full w-full object-cover object-[50%_58%] [filter:saturate(.78)_brightness(.72)_contrast(1.08)]"
      />
    </div>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(15,13,11,.7)_0%,rgba(15,13,11,.15)_28%,rgba(15,13,11,.35)_52%,rgba(15,13,11,.95)_100%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(120%_80%_at_50%_40%,transparent_40%,rgba(15,13,11,.55)_100%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(60%_45%_at_15%_62%,rgba(15,13,11,.7),transparent_70%)]"></div>
  </div>

  <div data-hero-content class="shell relative flex h-full flex-col justify-end pb-[clamp(1.5rem,4vh,3rem)]">
    <div class="mb-auto pt-28 md:pt-32">
      <p data-hero-fade class="eyebrow text-hueso/80">
        {brand.descriptor} <span class="mx-2 text-brasa">·</span> {contact.district}, CDMX
      </p>
    </div>

    <div class="grid items-end gap-8 md:grid-cols-12">
      <div class="md:col-span-7 lg:col-span-6">
        <p data-hero-fade class="font-display text-[clamp(1.6rem,3vw,2.6rem)] italic leading-[1.1] [font-variation-settings:'opsz'_48]">
          {brand.tagline}
        </p>
        <p data-hero-fade class="mt-5 max-w-md text-[0.98rem] leading-relaxed text-hueso/75">
          Catorce mesas alrededor de un solo fogón de encino y mezquite. Un menú que cambia con la leña,
          el maíz del día y la paciencia del humo.
        </p>
      </div>
      <div data-hero-fade class="flex flex-col gap-3 sm:flex-row md:col-span-5 md:justify-end lg:col-span-6">
        <Button href="#reservar">Reservar mesa</Button>
        <Button href="#carta" variant="ghost">Ver la carta</Button>
      </div>
    </div>

    <h1 id="hero-title" class="mt-8 md:mt-10">
      <span class="sr-only">Ceniza — cocina mexicana de humo y maíz en Roma Norte, Ciudad de México</span>
      <span
        data-hero-word
        aria-hidden="true"
        class="display flex w-full justify-between text-[clamp(4.6rem,20.5vw,22rem)] leading-[0.8] tracking-[-0.01em]"
      >
        {['C', 'E', 'N', 'I', 'Z', 'A'].map((l) => (
          <span class="inline-block overflow-hidden pb-[0.04em]">
            <span data-hero-letter class:list={['inline-block', l === 'Z' && 'relative']}>
              {l}
              {l === 'Z' && (
                <span class="absolute left-1/2 top-[0.02em] size-[0.09em] -translate-x-1/2 rounded-full bg-brasa shadow-[0_0_0.3em_var(--color-brasa)]" />
              )}
            </span>
          </span>
        ))}
      </span>
    </h1>

    <div data-hero-fade class="mt-5 flex items-center justify-between border-t border-hueso/15 pt-4 text-[0.6875rem] uppercase tracking-[0.3em] text-hueso/60">
      <span>Desde {brand.founded}</span>
      <span class="hidden sm:inline">Fuego de encino · Maíz criollo · Mezcal</span>
      <span class="flex items-center gap-3">
        Descubrir
        <span class="relative block h-6 w-px overflow-hidden bg-hueso/20" aria-hidden="true">
          <span class="scroll-cue absolute inset-x-0 top-0 h-1/2 bg-brasa"></span>
        </span>
      </span>
    </div>
  </div>
</section>

<style>
  .scroll-cue {
    animation: cue 2.4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes cue {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(220%); }
  }
</style>

---
import Img from './Img.astro';
import SectionHead from './SectionHead.astro';

const statement =
  'En Ceniza no hay estufas de gas. Hay un fogón de encino que se enciende a las seis de la mañana y no se apaga hasta el último café. Todo lo que servimos pasa por *él:* el maíz, la carne, la fruta, incluso el *hielo* de la barra.';

const facts = [
  { value: '14', label: 'Mesas por noche' },
  { value: '1', label: 'Fogón de encino' },
  { value: '0', label: 'Flamas de gas' },
];

const pillars = [
  { n: '01', t: 'Fuego', d: 'Encino para la carne, mezquite para el mar, rescoldo para lo dulce. Cada madera cocina distinto y la elegimos plato por plato.' },
  { n: '02', t: 'Maíz', d: 'Criollo azul, rojo y cacahuacintle de milpas de Puebla y Oaxaca, nixtamalizado en casa cada mañana y molido en metate.' },
  { n: '03', t: 'Tiempo', d: 'Costillas de catorce horas, moles de tres días y sobremesas sin reloj. Aquí nadie le retira el plato con prisa.' },
];
---

<section id="esencia" class="relative py-[clamp(6rem,14vw,12rem)]" aria-labelledby="esencia-title">
  <div class="shell">
    <SectionHead index="01" label="Nuestra esencia" />
    <h2 id="esencia-title" class="sr-only">Nuestra esencia: cocina de fuego de leña</h2>

    <div class="mt-10 grid gap-12 md:mt-14 lg:grid-cols-12 lg:items-end">
      <p
        data-scrub-words
        class="max-w-[24ch] font-display text-[clamp(2rem,4.6vw,4.6rem)] leading-[1.08] tracking-[-0.015em] [font-variation-settings:'opsz'_72] lg:col-span-9"
      >
        {
          statement.split(' ').map((w) => {
            const em = w.startsWith('*');
            const clean = w.replaceAll('*', '');
            return em ? <span class="w italic text-brasa">{clean} </span> : <span class="w">{clean} </span>;
          })
        }
      </p>
      <dl class="grid grid-cols-3 gap-6 border-t border-hueso/15 pt-6 lg:col-span-3 lg:grid-cols-1 lg:gap-8 lg:border-t-0 lg:pt-0">
        {
          facts.map((f) => (
            <div data-fade class="flex flex-col-reverse gap-3 lg:border-t lg:border-hueso/15 lg:pt-5">
              <dt class="eyebrow">{f.label}</dt>
              <dd class="font-display text-[clamp(2.6rem,4vw,3.6rem)] leading-none [font-variation-settings:'opsz'_96]">{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="mt-[clamp(4rem,9vw,8rem)] grid gap-10 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-7">
        <div data-reveal class="frame aspect-[4/3] md:aspect-[5/4]">
          <Img name="cazuela" alt="Cazuela de barro junto a llamas de leña sobre piedra" parallax={12} sizes="(min-width: 768px) 58vw, 100vw" class="scale-[1.18]" />
        </div>
      </div>

      <div class="flex flex-col justify-between gap-12 md:col-span-5 md:pl-6 lg:pl-12">
        <div data-reveal class="frame aspect-[3/2] w-[78%] self-end md:w-[72%]">
          <Img name="fuego" alt="Mazorcas de maíz asándose entre las llamas del horno de leña" parallax={10} sizes="(min-width: 768px) 30vw, 80vw" class="scale-[1.18]" />
        </div>
        <ol class="grid gap-8">
          {
            pillars.map((p) => (
              <li data-fade class="grid grid-cols-[3rem_1fr] gap-x-4 border-t border-hueso/15 pt-5">
                <span class="eyebrow pt-2 text-brasa">{p.n}</span>
                <div>
                  <h3 class="font-display text-[1.75rem] leading-none [font-variation-settings:'opsz'_48]">{p.t}</h3>
                  <p class="mt-3 text-[0.98rem] leading-relaxed text-hueso/70">{p.d}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

---
import Img from './Img.astro';
import Button from './Button.astro';
import SectionHead from './SectionHead.astro';
import { contact, hours } from '@/data/site';
---

<section id="reservar" class="relative overflow-hidden" aria-labelledby="reservar-title">
  <div class="absolute inset-0">
    <Img name="brasas" alt="" sizes="100vw" width={1920} height={781} parallax={14} class="h-full w-full scale-[1.3] object-cover" />
    <div class="absolute inset-0 bg-carbon/80"></div>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,var(--color-carbon)_0%,transparent_30%,transparent_70%,var(--color-carbon)_100%)]"></div>
  </div>

  <div class="shell relative grid min-h-[100svh] content-center gap-16 py-[clamp(6rem,12vw,10rem)] lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-7">
      <SectionHead index="06" label="Reservaciones" />
      <h2 id="reservar-title" data-split class="h-section mt-8">Su mesa,<br /><em>junto al fuego.</em></h2>
      <p data-fade class="lead mt-8">
        Reservamos por teléfono y WhatsApp: le contesta una persona del equipo, no un formulario. Para grupos de más
        de ocho y cenas privadas en la mesa del fogón, escríbanos con una semana de anticipación.
      </p>
      <div data-fade class="mt-10 flex flex-col gap-3 sm:flex-row">
        <Button href={contact.phoneHref}>Llamar para reservar</Button>
        <Button href={contact.whatsappHref} variant="ghost" external>Escribir por WhatsApp</Button>
      </div>
      <p data-fade class="mt-6 text-sm text-hueso/55">
        Respondemos de martes a domingo desde las 11:00 · <a href={contact.phoneHref} class="link-draw text-hueso/80">{contact.phoneDisplay}</a>
      </p>
    </div>

    <div class="grid gap-10 self-end sm:grid-cols-2 lg:col-span-4 lg:col-start-9 lg:grid-cols-1">
      <div data-fade>
        <h3 class="eyebrow text-hueso">Horario</h3>
        <dl class="mt-5 grid gap-3">
          {
            hours.map((h) => (
              <div class="flex items-baseline justify-between gap-4 border-b border-hueso/10 pb-3 text-[0.95rem]">
                <dt class="text-hueso/65">{h.days}</dt>
                <dd class="text-right tabular-nums text-hueso">{h.time}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div data-fade>
        <h3 class="eyebrow text-hueso">Dirección</h3>
        <p class="mt-5 font-display text-[1.6rem] leading-tight [font-variation-settings:'opsz'_48]">
          {contact.street}<br /><span class="italic text-hueso/70">{contact.district}, CDMX</span>
        </p>
        <a href={contact.mapsHref} target="_blank" rel="noopener noreferrer" class="link-draw mt-4 inline-flex min-h-11 items-center text-[0.6875rem] uppercase tracking-[0.3em] text-brasa">
          Cómo llegar
        </a>
      </div>
    </div>
  </div>
</section>
